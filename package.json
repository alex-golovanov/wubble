{
  "name": "wubble",
  "version": "0.1.0",
  "description": "Deterministic comic-lettering engine — bilingual SVG overlays from page manifests",
  "bin": {
    "wubble": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "wubble": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate:example": "bun run src/cli.ts validate examples/page-022.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run fmt:check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "opentype.js": "^1.3.4",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/opentype.js": "^1.3.8",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
